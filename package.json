{
  "name": "luaut-build",
  "version": "1.0.0",
  "description": "Compiles luaut to Luau: lowers the luaut-parser AST to a luau-parser AST and prints it",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "luaut-build": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "import": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "tsx scripts/test.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "luaut",
    "luau",
    "roblox",
    "compiler"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "luau-parser": "^1.0.3",
    "luaut-parser": "^4.0.0"
  },
  "devDependencies": {
    "@luaut/lua": "^2.0.0",
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
